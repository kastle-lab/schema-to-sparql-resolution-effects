#    Classes
#################################################################

###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/Earthquake
kwgl-ont:Earthquake rdf:type owl:Class ;
                    rdfs:subClassOf kwgl-ont:HazardEvent ;
                    rdfs:label "Earthquake" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/Fire
kwgl-ont:Fire rdf:type owl:Class ;
              rdfs:subClassOf kwgl-ont:HazardEvent ;
              rdfs:label "Fire" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/FireType
kwgl-ont:FireType rdf:type owl:Class ;
                  rdfs:label "Fire Type" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/HazardEvent
kwgl-ont:HazardEvent rdf:type owl:Class ;
                     rdfs:label "Hazard Event" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/HazardType
kwgl-ont:HazardType rdf:type owl:Class ;
                    rdfs:label "Hazard Type" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/Hurricane
kwgl-ont:Hurricane rdf:type owl:Class ;
                   rdfs:subClassOf kwgl-ont:HazardEvent ;
                   rdfs:label "Hurricane" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/Place
kwgl-ont:Place rdf:type owl:Class ;
               rdfs:label "Place" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/PlaceType
kwgl-ont:PlaceType rdf:type owl:Class ;
                   rdfs:label "Place Type" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/Tornado
kwgl-ont:Tornado rdf:type owl:Class ;
                 rdfs:subClassOf kwgl-ont:HazardEvent ;
                 rdfs:label "Tornado" .


###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty kwgl-ont:hasHazardType ;
                            owl:allValuesFrom kwgl-ont:HazardType
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty kwgl-ont:hasImpacted ;
                            owl:allValuesFrom kwgl-ont:Place
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty kwgl-ont:hasPlaceType ;
                            owl:allValuesFrom kwgl-ont:PlaceType
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty kwgl-ont:impactedBy ;
                            owl:allValuesFrom kwgl-ont:HazardEvent
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty kwgl-ont:isOfFireType ;
                            owl:allValuesFrom kwgl-ont:FireType
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty kwgl-ont:sfContains ;
                            owl:allValuesFrom kwgl-ont:Place
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty kwgl-ont:sfIntersects ;
                            owl:allValuesFrom kwgl-ont:Place
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty kwgl-ont:sfOverlaps ;
                            owl:allValuesFrom kwgl-ont:Place
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty kwgl-ont:sfTouches ;
                            owl:allValuesFrom kwgl-ont:Place
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty kwgl-ont:sfWithin ;
                            owl:allValuesFrom kwgl-ont:Place
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty kwgl-ont:spatialRelation ;
                            owl:allValuesFrom kwgl-ont:Place
                          ] ,
                          [ rdf:type owl:Restriction ;
