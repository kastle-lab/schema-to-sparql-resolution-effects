@prefix : <http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix kwglr: <http://stko-kwg.geog.ucsb.edu/lod/lite-resource/> .
@prefix terms: <http://purl.org/dc/terms/> .
@prefix kwgl-ont: <http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/> .
@base <http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/> .

<http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/> rdf:type owl:Ontology ;
                                                    terms:contributor """Krysztof Janowicz,
Pascal Hitzler,
Mark Schildhauer,
Dean Rehnberger,
Shirly Stephen,
Cogan Shimizu,
Colby Fisher,
Antrea Christou,
Adrita Barua,
Sanaz Saki Norouzi,
Kitty Currier
Abhilekha Dalal,
Mohammad Saeid Mahdavinejad,
Thomas Thelen,
Anthony D'Onofrio"""@en ;
                                                    terms:created "2023-06-14"@en ;
                                                    terms:creator "The KnowWhereGraph Project" ;
                                                    terms:description "This ontology supports the KnowWhereGraph Panels application"@en ;
                                                    rdfs:label "KWG-Lite Ontology"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/contributor
terms:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
terms:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
terms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
terms:description rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/hasHazardType
kwgl-ont:hasHazardType rdf:type owl:ObjectProperty ;
                       rdfs:domain kwgl-ont:HazardEvent ;
                       rdfs:range kwgl-ont:HazardType ;
                       rdfs:label "has hazard type" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/hasImpacted
kwgl-ont:hasImpacted rdf:type owl:ObjectProperty ;
                     owl:inverseOf kwgl-ont:impactedBy ;
                     rdfs:domain kwgl-ont:HazardEvent ;
                     rdfs:range kwgl-ont:Place ;
                     rdfs:label "has impacted" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/hasPlaceType
kwgl-ont:hasPlaceType rdf:type owl:ObjectProperty ;
                      rdfs:domain kwgl-ont:Place ;
                      rdfs:range kwgl-ont:PlaceType ;
                      rdfs:label "has place type" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/impactedBy
kwgl-ont:impactedBy rdf:type owl:ObjectProperty ;
                    rdfs:domain kwgl-ont:Place ;
                    rdfs:range kwgl-ont:HazardEvent ;
                    rdfs:label "impacted by" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/isOfFireType
kwgl-ont:isOfFireType rdf:type owl:ObjectProperty ;
                      rdfs:domain kwgl-ont:Fire ;
                      rdfs:range kwgl-ont:FireType ;
                      rdfs:label "is of fire type" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/sfContains
kwgl-ont:sfContains rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf kwgl-ont:spatialRelation ;
                    rdfs:domain kwgl-ont:Place ;
                    rdfs:range kwgl-ont:Place ;
                    rdfs:label "contains" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/sfIntersects
kwgl-ont:sfIntersects rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf kwgl-ont:spatialRelation ;
                      rdfs:domain kwgl-ont:Place ;
                      rdfs:range kwgl-ont:Place ;
                      rdfs:label "intersects" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/sfOverlaps
kwgl-ont:sfOverlaps rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf kwgl-ont:spatialRelation ;
                    rdfs:domain kwgl-ont:Place ;
                    rdfs:range kwgl-ont:Place ;
                    rdfs:label "overlaps" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/sfTouches
kwgl-ont:sfTouches rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf kwgl-ont:spatialRelation ;
                   rdfs:domain kwgl-ont:Place ;
                   rdfs:range kwgl-ont:Place ;
                   rdfs:label "touches" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/sfWithin
kwgl-ont:sfWithin rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf kwgl-ont:spatialRelation ;
                  rdfs:domain kwgl-ont:Place ;
                  rdfs:range kwgl-ont:Place ;
                  rdfs:label "within" .


###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/spatialRelation
kwgl-ont:spatialRelation rdf:type owl:ObjectProperty ;
                         rdfs:domain kwgl-ont:Place ;
                         rdfs:range kwgl-ont:Place ;
                         rdfs:label "spatial relation" .


#################################################################
#    Data properties
#################################################################

###  http://stko-kwg.geog.ucsb.edu/lod/lite-ontology/affectedAreaInAcres
kwgl-ont:affectedAreaInAcres rdf:type owl:DatatypeProperty ;
                             rdfs:domain kwgl-ont:HazardEvent ;
                             rdfs:range xsd:nonNegativeInteger ;
                             rdfs:label "affected area in acres" .


